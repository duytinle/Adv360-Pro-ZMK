#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"
      #ifndef VERSION_MACRO



        #endif

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <250>;
            quick_tap_ms = <160>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    macros {
        BoldItalic: BoldItalic {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(B) &kp LC(I) &kp RIGHT_ARROW>;
            label = "BOLDITALIC";
        };

        Brackets: Brackets {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LBKT &kp RBKT &kp LEFT_ARROW>;
            label = "BRACKETS";
        };

        Parenthesis: Paranthesis {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_PARENTHESIS &kp RIGHT_PARENTHESIS &kp LEFT_ARROW>;
            label = "PARANTHESIS";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp ESCAPE  &kp N1            &kp N2               &kp N3          &kp N4     &kp N5  &kp EXCLAMATION                                                                                   &kp EQUAL     &kp N6  &kp N7    &kp N8           &kp N9               &kp N0                &kp BACKSLASH
&kp TAB     &kp Q             &kp W                &kp E           &kp R      &kp T   &mt LC(TAB) SQT                                                                                   &kp LC(Z)     &kp Y   &kp U     &kp I            &kp O                &kp P                 &kp MINUS
&kp CAPS    &hm LEFT_SHIFT A  &hm LEFT_CONTROL S   &hm LEFT_ALT D  &kp F      &kp G   &mt DOUBLE_QUOTES COLON  &mo 1       &mo 2                  &mt LA(LS(B)) LA(Z)        &kp RCTRL  &kp QUESTION  &kp H   &kp J     &hm RIGHT_ALT K  &hm RIGHT_CONTROL L  &hm RIGHT_SHIFT SEMI  &kp SQT
&kp LSHFT   &kp Z             &kp X                &kp C           &kp V      &kp B                                        &mt LEFT_ALT HOME      &mt LC(LS(ESCAPE)) DELETE                           &kp N   &kp M     &kp COMMA        &kp DOT              &kp FSLH              &kp RSHFT
&kp LC(A)   &kp LC(C)         &mt LC(LS(V)) LC(V)  &kp LEFT        &kp RIGHT          &kp BSPC                 &kp DELETE  &mt LC(X) END          &mo 3                      &kp ENTER  &kp SPACE             &kp LEFT  &kp DOWN         &kp UP_ARROW         &kp RIGHT             &kp ENTER
            >;
        };

        fn {
            bindings = <
&kp LG(LA(B))            &kp F1                          &kp F2           &kp F3          &kp F4         &kp F5     &kp PRINTSCREEN                                              &none   &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &kp F11
&kp LS(LC(LG(B)))        &kp PRINTSCREEN                 &kp LC(Y)        &kp LC(E)       &kp LC(R)      &kp LC(L)  &kp LS(F3)                                                   &none   &trans  &trans  &trans  &trans  &trans   &kp F12
&kp LS(LA(PRINTSCREEN))  &kp LS(LC(COMMA))               &kp LS(LC(DOT))  &kp LC(J)       &kp LA(LC(F))  &Brackets  &BoldItalic      &trans  &trans      &BoldItalic  &Brackets  &none   &trans  &trans  &trans  &trans  &trans   &trans
&kp LA(LC(S))            &kp LS(F5)                      &kp LA(N5)       &kp LS(LC(N8))  &kp LC(I)      &kp LC(B)                           &trans      &none                           &trans  &trans  &trans  &trans  &trans   &trans
&Parenthesis             &mt RIGHT_BRACKET LEFT_BRACKET  &kp PIPE         &kp LS(HOME)    &kp LS(END)               &trans           &trans  &trans      &trans       &trans     &trans          &trans  &trans  &trans  &trans   &trans
            >;
        };

        keypad {
            bindings = <
&kp LG(LA(B))      &kp N1                &kp N2                &kp N3                &kp N4                &kp N5          &kp LS(LC(N8))                                                &none      &none  &kp KP_NUM  &kp KP_EQUAL  &kp KP_DIVIDE  &kp KP_MULTIPLY  &kp MINUS
&kp LG(LC(LS(B)))  &none                 &none                 &none                 &none                 &none           &kp LS(LC(N7))                                                &none      &none  &kp KP_N7   &kp KP_N8     &kp KP_N9      &kp KP_MINUS     &kp BSLH
&none              &kp LS(LC(NUMBER_1))  &kp LS(LC(NUMBER_2))  &kp LS(LC(NUMBER_3))  &kp LS(LC(NUMBER_4))  &kp LS(LC(N5))  &kp LS(LC(NUMBER_6))  &none  &none      &kp LGUI   &kp RCTRL  &none      &none  &kp KP_N4   &kp KP_N5     &kp KP_N6      &kp KP_PLUS      &kp SQT
&kp LSHFT          &none                 &none                 &none                 &kp PAGE_UP           &kp PAGE_DOWN                                &none      &kp PG_UP                        &none  &kp KP_N1   &kp KP_N2     &kp KP_N3      &kp KP_ENTER     &kp RSHFT
&kp LC(LS(D))      &none                 &none                 &kp LS(LC(HOME))      &kp LS(LC(END))                       &none                 &none  &none      &kp PG_DN  &kp ENTER  &kp KP_N0         &kp UP      &kp DOWN      &kp KP_DOT     &kp RBKT         &none
            >;
        };

        mod {
            bindings = <
&none  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                           &trans                  &none  &none       &none       &none  &none  &none
&none  &none         &none         &none         &none         &none         &bootloader                                                     &bootloader             &none  &none       &none       &none  &none  &none
&none  &none         &none         &none         &none         &none         &rgb_ug RGB_BRD  &bt BT_CLR  &none      &bt BT_CLR  &none       &rgb_ug RGB_MEFS_CMD 5  &none  &none       &none       &none  &none  &none
&none  &none         &none         &none         &none         &none                                      &none      &none                                           &none  &none       &none       &none  &none  &none
&none  &none         &none         &bl BL_INC    &bl BL_DEC                  &rgb_ug RGB_TOG  &bl BL_TOG  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG                &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };
    };
};
